#!/bin/sh
# The host mounts the cached runtime package read-only during container startup.
TOOLS_ENTRY="/opt/sandbox-cli/dist/apps/sandbox-container-tools/main.js"
if [ ! -f "$TOOLS_ENTRY" ]; then
  echo "Sandbox container tools are not available: $TOOLS_ENTRY" >&2
  echo "The Sandbox runtime package is missing. Start this container through Sandbox on the host." >&2
  exit 1
fi
exec /usr/bin/node "$TOOLS_ENTRY" "$@"
